<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Update Post</title>
</head>

<body>
    <p>Id : <%=post.id%>
    </p>
    <p>UserName : @<%=post.username%>
    </p>
    <form action="http://localhost:3000/posts/<%=post.id%>?_method=PATCH" method="POST">
        <label for="username">Content : </label>
        <textarea name="content" rows="20" cols="35" style="scrollbar-width: none;">
            <%=post.content%>
        </textarea>
        <hr>
        <button>Submit Change</button>
    </form>

</body>

</html>